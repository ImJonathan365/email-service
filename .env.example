# Local development placeholders. Copy to .env (git-ignored) and change them.
# Never put real credentials in this file.

APP_ENV=local

# Only for running the app or migrations from the host (./gradlew bootRun) against the compose
# PostgreSQL; docker compose sets its own DB_URL for the app container.
DB_URL=jdbc:postgresql://localhost:5432/email_service

# PostgreSQL superuser of the local container (only used to create the roles).
POSTGRES_PASSWORD=change-me-postgres

# Database roles (ADR-0008). Created by scripts/init-db-roles.sql on the first start.
DB_OWNER_USER=email_owner
DB_OWNER_PASSWORD=change-me-owner
DB_APP_USER=email_app
DB_APP_PASSWORD=change-me-app
DB_SYSTEM_USER=email_system
DB_SYSTEM_PASSWORD=change-me-system

# Administration credential for /admin/v1/** (X-Admin-Key). At least 32 characters; several may be
# given comma-separated to rotate. Generate a real one with: openssl rand -base64 32
ADMIN_API_KEYS=change-me-local-admin-key-at-least-32-chars

# HMAC key for suppression lookups (email_hash, ADR-0012). At least 32 characters. Losing it makes
# existing suppression hashes unusable, so production keeps an offline backup (docs/08 §1).
SUPPRESSION_HASH_KEY=change-me-local-suppression-hash-key-32
