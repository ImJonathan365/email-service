# Local development placeholders. Copy to .env (git-ignored) and change them.
# Never put real credentials in this file.

APP_ENV=local

# PostgreSQL superuser of the local container (only used to create the roles).
POSTGRES_PASSWORD=change-me-postgres

# Database roles (ADR-0008). Created by scripts/init-db-roles.sql on the first start.
DB_OWNER_USER=email_owner
DB_OWNER_PASSWORD=change-me-owner
DB_APP_USER=email_app
DB_APP_PASSWORD=change-me-app
DB_SYSTEM_USER=email_system
DB_SYSTEM_PASSWORD=change-me-system
